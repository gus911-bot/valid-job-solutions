# ───────────── Supabase ─────────────
# Côté CLIENT (exposées au navigateur) — sans danger.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Côté SERVEUR UNIQUEMENT — NE JAMAIS exposer / committer.
# REQUISE : upload des CV (Storage) + URLs signées admin. Jamais dans un composant client.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete

# URL publique du site (liens absolus, sitemap, OG, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (Optionnel) Rate limiting partagé multi-instances via Upstash Redis.
# Si absent → limiteur en mémoire (suffisant pour 1 instance).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ───────────── Web Push (notifications admin) ─────────────
# Générer une paire de clés : npx web-push generate-vapid-keys
# Si absentes → les notifications push sont simplement désactivées.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=votre-cle-publique-vapid
VAPID_PRIVATE_KEY=votre-cle-privee-vapid
# VAPID_SUBJECT=mailto:contact@exemple.com
