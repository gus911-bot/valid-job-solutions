# ───────────── Supabase ─────────────
# Côté CLIENT (exposées au navigateur) — sans danger.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Côté SERVEUR UNIQUEMENT — NE JAMAIS exposer / committer.
# REQUISE : upload des CV (Storage) + URLs signées admin. Jamais dans un composant client.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete

# URL publique du site (liens absolus, sitemap, OG, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (Recommandé en production) Rate limiting partagé multi-instances via Upstash Redis.
# ⚠️  Sur Vercel (fonctions serverless), sans Upstash le rate limit est PAR INSTANCE :
#     "5 req/min" devient "5 × N instances" — les bots contournent la limite.
# Setup gratuit (~3 min) :
#   1. Créer un compte sur https://upstash.com (Google/GitHub login)
#   2. Console → Create Database → nom quelconque, région proche → Create
#   3. Onglet "REST API" → copier UPSTASH_REDIS_REST_URL et UPSTASH_REDIS_REST_TOKEN
#   4. Coller les 2 valeurs ici puis dans Vercel → Settings → Environment Variables
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ───────────── Web Push (notifications admin) ─────────────
# Générer une paire de clés : npx web-push generate-vapid-keys
# Si absentes → les notifications push sont simplement désactivées.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=votre-cle-publique-vapid
VAPID_PRIVATE_KEY=votre-cle-privee-vapid
# VAPID_SUBJECT=mailto:contact@exemple.com
